# Copy to workers/api/.env. Never commit real secrets.

# development | test | production
# Any other value is treated as production: dev sign-in stays off and HTTPS is required.
ENVIRONMENT=development

# Browser origin. Vite proxies /api to the API on port 8787.
PUBLIC_APP_URL=http://localhost:5173

DATABASE_URL=postgres://broke:broke@localhost:5432/broke_no_more

# At least 32 characters. The placeholder below is refused when ENVIRONMENT=production.
SESSION_SECRET=local-dev-only-session-secret-not-for-production

# Local only. Production refuses dev sign-in even if this is true.
DEV_AUTH_ENABLED=true

# Direct Google OIDC. Redirect URI: http://localhost:5173/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cognito user pool with Google as the identity provider. Preferred when all three ids are set.
# Redirect URI: http://localhost:5173/api/v1/auth/cognito/callback
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=

# Reserved for Phase 1 Gmail refresh tokens. Not read in Phase 0.
TOKEN_ENCRYPTION_KEY=

# Optional later classification fallback. Not read in Phase 0. Put the real key only in workers/api/.env.
OPENAI_API_KEY=
