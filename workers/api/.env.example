ENVIRONMENT=development
PUBLIC_APP_URL=http://localhost:5173
DEV_AUTH_ENABLED=true
SESSION_SECRET=local-dev-only-session-secret-not-for-production
DATABASE_URL=postgres://broke:broke@localhost:5432/broke_no_more

# Direct Google OIDC, used when Cognito is not configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cognito hosted UI with a Google identity provider. Preferred when set.
# Region default is ap-southeast-1. Do not put gmail scopes on this client.
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=

# 32-byte key, base64. Used only to seal Gmail refresh tokens. Generate with:
# node -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=

# Optional. Not read until classification exists. Keep it only in this gitignored file.
OPENAI_API_KEY=
